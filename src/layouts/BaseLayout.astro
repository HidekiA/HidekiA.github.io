---
interface Props {
  title: string;
  description?: string;
}

const { title, description = "Hideki AOYAMA, PhD (青山 秀紀) Profile" } = Astro.props;
---

<!doctype html>
<html lang="ja">
<head prefix="og: http://ogp.me/ns#">
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="shortcut icon" type="image/x-icon" href="/favicon.ico" />

  <meta property="og:url" content="https://HidekiA.github.io" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:site_name" content="Hideki AOYAMA" />
  <meta property="og:image" content="https://HidekiA.github.io/img/HidekiA.jpg" />

  <title>{title}</title>

  <!-- Google Analytics -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-76E3Z92W8L"></script>
  <script is:inline>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', 'G-76E3Z92W8L');
  </script>
</head>

<body>
  <slot />
</body>
</html>

<style is:global>
  @import url('https://fonts.googleapis.com/css2?family=Newsreader:wght@700&family=Noto+Serif+JP&display=swap');

  *, *::before, *::after {
    box-sizing: border-box;
  }

  html {
    font-size: 16px;
    scroll-behavior: smooth;
  }

  body {
    margin: 0;
    font-size: 1.1rem;
    font-family: 'Newsreader', 'Noto Serif JP', serif;
    font-weight: 700;
    line-height: 1.6;
    color: #222;
    padding-bottom: 80px;
  }

  img {
    max-width: 100%;
    height: auto;
  }

  a {
    color: #0d6efd;
    text-decoration: none;
  }
  a:hover {
    color: red;
    text-decoration: underline;
  }

  small {
    font-size: 0.85em;
  }

  .section-title {
    font-size: 1.8rem;
    font-weight: bold;
    color: white;
    background-color: #5179f1;
    text-align: center;
    padding: .6rem 0 .4rem;
    border-radius: .2em;
  }

  .subtitle {
    font-size: 1.4rem;
    font-weight: bold;
    color: #00008b;
    margin-top: 2rem;
    margin-bottom: 0.5rem;
  }

  section {
    max-width: 960px;
    margin: 0 auto;
    padding: 80px 1rem 0;
  }
</style>
