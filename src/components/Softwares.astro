---
import { getCollection } from 'astro:content';

const allSoftware = (await getCollection('softwares')).sort((a, b) => a.data.order - b.data.order);
---

<section id="softwares">
  <div class="section-title">Free softwares</div>

  {allSoftware.map((sw, i) => (
    <>
      <article class="software">
        <div class="software-content">
          <div class="info">
            <h3>{sw.data.title}</h3>
            <p>
              {sw.data.description}
              {sw.data.link && (
                <a href={sw.data.link}>[{sw.data.linkLabel}]</a>
              )}
            </p>
            {sw.data.descriptionJa && (
              <p>{sw.data.descriptionJa}</p>
            )}
            {sw.data.links?.map((link) => (
              <p><a href={link.url}>[{link.label}]</a></p>
            ))}
          </div>
          <div class="image">
            <img src={sw.data.image} alt={sw.data.title} />
          </div>
        </div>
      </article>
      {i < allSoftware.length - 1 && <hr />}
    </>
  ))}
</section>

<style>
  .software {
    margin: 1.5rem 0;
  }

  .software-content {
    display: flex;
    gap: 1.5rem;
    align-items: center;
  }

  .info {
    flex: 1;
  }

  .info h3 {
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
  }

  .info p {
    font-weight: 400;
    margin: 0.4rem 0;
  }

  .image {
    flex-shrink: 0;
    max-width: 300px;
  }

  .image img {
    width: 100%;
    display: block;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    padding: 4px;
    background: white;
  }

  hr {
    border: none;
    border-top: 1px solid #dee2e6;
    margin: 1rem 0;
  }

  @media (max-width: 640px) {
    .software-content {
      flex-direction: column;
    }
    .image {
      max-width: 80%;
    }
  }
</style>
