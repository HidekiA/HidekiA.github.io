---
import { getCollection, render } from 'astro:content';

const allSoftware = (await getCollection('software')).sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
  allSoftware.map(async (sw) => {
    const { Content } = await render(sw);
    return { sw, Content };
  })
);
---

<section id="softwares">
  <div class="section-title">Free softwares</div>

  {rendered.map(({ sw, Content }, i) => {
    const imgWide = sw.data.imageWidthSideBySide ?? 30;
    const imgNarrow = sw.data.imageWidthStacked ?? 50;
    return (
      <>
        <article
          class="software"
          style={`--img-wide: ${imgWide}%; --img-narrow: ${imgNarrow}%;`}
        >
          <h3>{sw.data.title}</h3>
          <div class="software-content">
            <div class="info">
              <Content />
            </div>
            <div class="image">
              <img src={sw.data.image} alt={sw.data.title} />
            </div>
          </div>
        </article>
        {i < rendered.length - 1 && <hr />}
      </>
    );
  })}
</section>

<style>
  .software {
    margin: 1.5rem 0;
  }

  .software h3 {
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
  }

  .software-content {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 0 1em;
  }

  .info {
    width: 100%;
    font-weight: 400;
  }

  .info :global(p) {
    margin: 0.4rem 0;
  }

  .image {
    width: var(--img-narrow);
    margin: 0 auto;
  }

  .image img {
    width: 100%;
    display: block;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    padding: 4px;
    background: white;
  }

  @media (min-width: 640px) {
    .software-content {
      flex-direction: row;
      align-items: flex-start;
    }

    .info {
      width: calc(100% - var(--img-wide));
      flex-shrink: 0;
    }

    .image {
      width: var(--img-wide);
      flex-shrink: 0;
      margin: 0;
    }
  }

  hr {
    border: none;
    border-top: 1px solid #dee2e6;
    margin: 1rem 0;
  }
</style>
