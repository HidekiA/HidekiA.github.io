---
import { getCollection, render } from 'astro:content';
import T from './T.astro';

const allSoftware = (await getCollection('software')).sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
  allSoftware.map(async (sw) => {
    const { Content } = await render(sw);
    return { sw, Content };
  })
);
---

<section id="softwares">
  <div class="section-title"><T en="Softwares" /></div>

  {rendered.map(({ sw, Content }) => (
    <article class="software">
      <h3>{sw.data.title}</h3>
      <div class="info">
        <Content />
      </div>
    </article>
  ))}
</section>

<style>
  .software {
    margin: 1rem 0 0;
  }

  .software h3 {
    font-size: 1.2rem;
    margin: 0 0 0.25rem;
  }

  .info {
    padding: 0 1em;
    font-weight: 400;
  }

  .info :global(p) {
    margin: 0.3rem 0;
  }
</style>
