---
import { getCollection } from 'astro:content';
import T from './T.astro';

const allLicenses = await getCollection('licenses');
const licenseEntries = allLicenses.filter(e => e.data.section === 'licenses');
const certEntries = allLicenses.filter(e => e.data.section === 'certificates');
---

<section id="licenses">
  <div class="section-title"><T en="Licenses & Certificates" ja="免許・資格" /></div>

  <div class="subtitle"><T en="Licenses" ja="免許" /></div>
  <div class="license-list">
    {licenseEntries.map((entry) => (
      <div class="category-group">
        <div class="category-label"><T en={entry.data.category.en} ja={entry.data.category.ja} />:</div>
        <div class="items">
          {entry.data.items.map((item, i) => (
            <>{i > 0 && ' / '}{item.link ? <a href={item.link}><T en={item.name.en} ja={item.name.ja} /></a> : <T en={item.name.en} ja={item.name.ja} />}</>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="subtitle"><T en="Certificates" ja="資格" /></div>
  <div class="license-list">
    {certEntries.map((entry) => (
      <div class="category-group">
        <div class="category-label"><T en={entry.data.category.en} ja={entry.data.category.ja} />:</div>
        <div class="items">
          {entry.data.items.map((item, i) => (
            <>{i > 0 && ' / '}{item.link ? <a href={item.link}><T en={item.name.en} ja={item.name.ja} /></a> : <T en={item.name.en} ja={item.name.ja} />}</>
          ))}
          {entry.data.items.some(item => item.badge) && (
            <div class="badges">
              {entry.data.items.filter(item => item.badge).map((item) => (
                <a href={item.link}>
                  <img src={item.badge} alt={item.name.en} width="120" height="120" />
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .license-list {
    margin: 0.5rem 0 0 0.5rem;
  }

  .category-group {
    margin-bottom: 1rem;
  }

  .category-label {
    color: #555;
  }

  .items {
    margin-left: 0.5rem;
    font-weight: 400;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
    margin-left: 1rem;
  }

  .badges img {
    display: block;
  }
</style>
