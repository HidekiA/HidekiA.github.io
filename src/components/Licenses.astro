---
import { getCollection } from 'astro:content';

const allLicenses = await getCollection('licenses');
const licenseEntries = allLicenses
  .filter(e => e.data.section === 'licenses')
  .sort((a, b) => a.data.order - b.data.order);
const certEntries = allLicenses
  .filter(e => e.data.section === 'certificates')
  .sort((a, b) => a.data.order - b.data.order);
---

<section id="licenses">
  <div class="section-title">Licenses & Certificates</div>

  <div class="subtitle">Licenses</div>
  <div class="license-list">
    {licenseEntries.map((entry) => (
      <div class="category-group">
        <div class="category-label">{entry.data.category}:</div>
        <div class="items">
          {entry.data.items.map((item, i) => (
            <>{i > 0 && ' / '}{item.link ? <a href={item.link}>{item.name}</a> : item.name}</>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="subtitle">Certificates</div>
  <div class="license-list">
    {certEntries.map((entry) => (
      <div class="category-group">
        <div class="category-label">{entry.data.category}:</div>
        <div class="items">
          {entry.data.items.map((item, i) => (
            <>{i > 0 && ' / '}{item.link ? <a href={item.link}>{item.name}</a> : item.name}</>
          ))}
          {entry.data.items.some(item => item.badge) && (
            <div class="badges">
              {entry.data.items.filter(item => item.badge).map((item) => (
                <a href={item.link}>
                  <img src={item.badge} alt={item.name} width="120" height="120" />
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .license-list {
    margin: 0.5rem 0 0 0.5rem;
  }

  .category-group {
    margin-bottom: 1rem;
  }

  .category-label {
    color: #555;
  }

  .items {
    margin-left: 0.5rem;
    font-weight: 400;
  }

  .badges {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 0.75rem;
    margin-left: 1rem;
  }

  .badges img {
    display: block;
  }
</style>
