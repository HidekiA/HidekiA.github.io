---
import publications from '../content/publications.json';
import T from './T.astro';
---

<section id="publications">
  <div class="section-title"><T en="Publications" ja="論文" /></div>

  <div class="subtitle"><T en="Recent Papers" ja="発表論文" /></div>
  <ol class="paper-list">
    {publications.map((pub) => (
      <li>
        {pub.authors},
        &ldquo;{pub.title},&rdquo;
        {pub.venue}
        {pub.links.map((link) => (
          <> [{('url' in link && link.url) ? <a href={link.url}>{link.label}</a> : link.label}]</>
        ))}
      </li>
    ))}
  </ol>

  <div class="subtitle">Google Scholar</div>
  <div class="scholar-card">
    <div class="scholar-header">
      <img src="/img/Google_Scholar_logo.png" alt="" height="30" />
      <a href="https://scholar.google.com/citations?user=pgHBLQcAAAAJ">Google Scholar</a>
    </div>
    <div class="scholar-body">
      <h3>Hideki AOYAMA (青山 秀紀)</h3>
      <p>
        Panasonic / Real-AI Team<br />Cited by: 4,564<br />
        <small>Machine Learning / Pattern Recognition / Visible Light Communication / Computer Vision / Ensemble Learning / Reinforcement Learning / VLM / Humanoid Robot</small>
      </p>
    </div>
  </div>
</section>

<style>
  .paper-list {
    margin-top: 1rem;
    padding-right: 0.5rem;
  }

  .paper-list li {
    font-family: 'Noto Serif JP', serif;
    font-weight: 400;
    font-size: 1rem;
    margin-top: 0.6rem;
  }

  .scholar-card {
    max-width: 600px;
    margin: 1rem auto 0;
    border: 1px solid #dee2e6;
    border-radius: 0.5rem;
    overflow: hidden;
  }

  .scholar-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background-color: #e8f0ff;
    font-weight: bold;
  }

  .scholar-header img {
    height: 30px;
    width: auto;
  }

  .scholar-body {
    padding: 1rem;
  }

  .scholar-body h3 {
    font-size: 1.2rem;
    margin: 0 0 0.5rem;
  }

  .scholar-body p {
    margin: 0;
    font-weight: 400;
  }
</style>
