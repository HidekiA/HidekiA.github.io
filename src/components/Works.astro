---
import { getCollection, render } from 'astro:content';
import T from './T.astro';

const allWorks = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
  allWorks.map(async (work) => {
    const { Content } = await render(work);
    return { work, Content };
  })
);
---

<section id="works">
  <div class="section-title"><T en="Works" ja="業績" /></div>

  {rendered.map(({ work, Content }, i) => (
    <>
      <article class="work">
        {work.data.logo && (
          <div class="logo">
            <img src={work.data.logo.src} style={`height: ${work.data.logo.height}`} />
          </div>
        )}

        {!work.data.logo && <h3 class="work-title"><T en={work.data.title.en} ja={work.data.title.ja} /></h3>}

        <div class={`work-content ${work.data.contentLayout === 'side-by-side' ? 'side-by-side' : ''}`}>
          <div class="work-body">
            <Content />
          </div>

          <div class="media-grid">
            {work.data.images?.map((img) => (
              <div class="media-item">
                {img.link ? (
                  <a href={img.link}>
                    <img src={img.src} alt={img.alt || ''} class="thumbnail" />
                  </a>
                ) : (
                  <img src={img.src} alt={img.alt || ''} class="thumbnail" />
                )}
              </div>
            ))}

            {work.data.image && (
              <div class="media-item">
                {work.data.link ? (
                  <a href={work.data.link}>
                    <img src={work.data.image.src} alt={work.data.image.alt} class="thumbnail" />
                  </a>
                ) : (
                  <img src={work.data.image.src} alt={work.data.image.alt} class="thumbnail" />
                )}
              </div>
            )}

            {work.data.videos?.map((url) => (
              <div class="media-item">
                <div class="video-wrapper">
                  <iframe src={url} title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
                </div>
              </div>
            ))}
          </div>
        </div>

        {work.data.storeLinks && work.data.storeLinks.length > 0 && (
          <div class="store-links">
            {work.data.storeLinks.map((store) => (
              <a href={store.link}>
                <img src={store.src} style={`height: ${store.height}`} />
              </a>
            ))}
          </div>
        )}
      </article>
      {i < rendered.length - 1 && <hr />}
    </>
  ))}
</section>

<style>
  .work {
    margin: 1.5rem 0;
  }

  .work-title {
    font-size: 1.5rem;
    margin: 0.5rem 0;
  }

  .logo {
    margin-bottom: 0.5rem;
  }

  .work-content {
    display: flex;
    flex-direction: column;
    padding: 0 1em;
  }

  @media (min-width: 640px) {
    .work-content.side-by-side {
      flex-direction: row;
      gap: 1.5rem;
      align-items: flex-start;
    }

    .work-content.side-by-side .work-body {
      flex: 1;
    }

    .work-content.side-by-side .media-grid {
      flex: 1;
      margin-top: 0;
    }
  }

  .work-body {
    margin: 0.5rem 0;
    font-size: 1.1rem;
  }
  .work-body :global(p) {
    margin: 0.3rem 0;
  }

  .media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
    align-items: center;
  }

  .media-item img.thumbnail {
    width: 100%;
    display: block;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    padding: 4px;
    background: white;
  }

  .video-wrapper {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
  }
  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .store-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
    align-items: center;
    padding: 0 1em;
  }
  .store-links img {
    display: block;
  }

  hr {
    border: none;
    border-top: 1px solid #dee2e6;
    margin: 1rem 0;
  }
</style>
