---
import { getCollection } from 'astro:content';

const allWorks = (await getCollection('works')).sort((a, b) => a.data.order - b.data.order);
---

<section id="works">
  <div class="section-title">Works</div>

  {allWorks.map((work, i) => (
    <>
      <article class="work">
        {/* Logo */}
        {work.data.logo && (
          <div class="logo">
            <img src={work.data.logo.src} style={`height: ${work.data.logo.height}`} />
          </div>
        )}

        {/* Title (for items without a logo or standard layout) */}
        {!work.data.logo && <h3 class="work-title">{work.data.title}</h3>}

        {/* Role description */}
        {work.data.role && (
          <div class="role">
            {work.data.role.split('\n').map((line) => <>{line}<br /></>)}
          </div>
        )}

        {/* Standard link */}
        {work.data.standardLink && work.data.standardTitle && (
          <div class="standard-link">
            <a href={work.data.standardLink}>
              {work.data.standardTitle.split('\n').map((line) => <>{line}<br /></>)}
            </a>
          </div>
        )}

        {/* Grid of images + optional single image */}
        <div class="media-grid">
          {work.data.images?.map((img) => (
            <div class="media-item">
              {img.link ? (
                <a href={img.link}>
                  <img src={img.src} alt={img.alt || ''} class="thumbnail" />
                </a>
              ) : (
                <img src={img.src} alt={img.alt || ''} class="thumbnail" />
              )}
            </div>
          ))}

          {work.data.image && (
            <div class="media-item">
              <img src={work.data.image.src} alt={work.data.image.alt} class="thumbnail" />
            </div>
          )}

          {work.data.videos?.map((url) => (
            <div class="media-item">
              <div class="video-wrapper">
                <iframe src={url} title="YouTube video player" frameborder="0" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture" allowfullscreen></iframe>
              </div>
            </div>
          ))}
        </div>

        {/* Store links */}
        {work.data.storeLinks && work.data.storeLinks.length > 0 && (
          <div class="store-links">
            {work.data.storeLinks.map((store) => (
              <a href={store.link}>
                <img src={store.src} style={`height: ${store.height}`} />
              </a>
            ))}
          </div>
        )}
      </article>
      {i < allWorks.length - 1 && <hr />}
    </>
  ))}
</section>

<style>
  .work {
    margin: 1.5rem 0;
  }

  .work-title {
    font-size: 1.5rem;
    margin: 0.5rem 0;
  }

  .logo {
    margin-bottom: 0.5rem;
  }

  .role {
    font-size: 1.1rem;
    margin: 0.75rem 0;
  }

  .standard-link {
    margin: 0.75rem 0;
  }

  .media-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1rem;
    margin-top: 1rem;
    align-items: center;
  }

  .media-item img.thumbnail {
    width: 100%;
    display: block;
    border: 1px solid #dee2e6;
    border-radius: 4px;
    padding: 4px;
    background: white;
  }

  .video-wrapper {
    position: relative;
    padding-bottom: 56.25%;
    height: 0;
  }
  .video-wrapper iframe {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
  }

  .store-links {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-top: 1rem;
    align-items: center;
  }
  .store-links img {
    display: block;
  }

  hr {
    border: none;
    border-top: 1px solid #dee2e6;
    margin: 1rem 0;
  }
</style>
