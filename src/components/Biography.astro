---
import { getCollection } from 'astro:content';
import T from './T.astro';

const allBio = await getCollection('biography');
const affiliations = allBio.filter(e => e.data.category === 'affiliation').sort((a, b) => a.data.order - b.data.order);
const education = allBio.filter(e => e.data.category === 'education').sort((a, b) => a.data.order - b.data.order);
---

<section id="biography">
  <div class="section-title"><T en="Biography" ja="経歴" /></div>

  <div class="subtitle"><T en="Professional Affiliation" ja="職歴" /></div>
  <div class="entry-list">
    {affiliations.map((entry) => (
      <div class="entry">
        <div class="period">{entry.data.period}</div>
        <div class="detail">
          <T en={entry.data.title.en} ja={entry.data.title.ja} />
          {entry.data.subtitle && <><br /><small><T en={entry.data.subtitle.en} ja={entry.data.subtitle.ja} /></small></>}
        </div>
      </div>
    ))}
  </div>

  <div class="subtitle"><T en="Education" ja="学歴" /></div>
  <div class="entry-list">
    {education.map((entry) => (
      <div class="entry">
        <div class="period">{entry.data.period}</div>
        <div class="detail">
          <T en={entry.data.title.en} ja={entry.data.title.ja} />
          {entry.data.subtitle && <><br /><small><T en={entry.data.subtitle.en} ja={entry.data.subtitle.ja} /></small></>}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .entry-list {
    margin-top: 0.5rem;
    padding: 0 1em;
  }

  .entry {
    display: flex;
    gap: 1rem;
    margin-bottom: 0.25rem;
  }

  .period {
    flex-shrink: 0;
    width: 140px;
    padding: 0.4rem 0.6rem;
    background-color: #e8f0ff;
    font-size: 0.95rem;
  }

  .detail {
    padding: 0.4rem 0;
  }

  @media (max-width: 640px) {
    .entry {
      flex-direction: column;
      gap: 0;
      margin-bottom: 0.75rem;
    }
    .period {
      width: auto;
    }
  }
</style>
