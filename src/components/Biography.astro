---
import { getCollection } from 'astro:content';
import T from './T.astro';

const allBio = await getCollection('biography');
const affiliations = allBio.filter(e => e.data.category === 'affiliation').sort((a, b) => a.data.order - b.data.order);
const education = allBio.filter(e => e.data.category === 'education').sort((a, b) => a.data.order - b.data.order);
---

<section id="biography">
  <div class="section-title"><T en="Biography" /></div>

  <div class="subtitle"><T en="Professional Affiliation" ja="職歴" /></div>
  <div class="entry-list">
    {affiliations.map((entry) => (
      <div class:list={['entry', { connected: entry.data.connected }]}>
        <div class="period">{entry.data.period}</div>
        <div class="detail">
          <span data-i18n-en>
            {entry.data.title.en}
            {entry.data.subtitle && <><br /><small>{entry.data.subtitle.en}</small></>}
          </span>
          <span data-i18n-ja>
            {entry.data.title.ja ?? entry.data.title.en}
            {entry.data.subtitle?.ja && <><br /><small>{entry.data.subtitle.ja}</small></>}
          </span>
        </div>
      </div>
    ))}
  </div>

  <div class="subtitle"><T en="Education" ja="学歴" /></div>
  <div class="entry-list">
    {education.map((entry) => (
      <div class:list={['entry', { connected: entry.data.connected }]}>
        <div class="period">{entry.data.period}</div>
        <div class="detail">
          <span data-i18n-en>
            {entry.data.title.en}
            {entry.data.subtitle && <><br /><small>{entry.data.subtitle.en}</small></>}
          </span>
          <span data-i18n-ja>
            {entry.data.title.ja ?? entry.data.title.en}
            {entry.data.subtitle?.ja && <><br /><small>{entry.data.subtitle.ja}</small></>}
          </span>
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .entry-list {
    margin-top: 0.5rem;
    padding: 0 1em;
  }

  .entry {
    display: flex;
    gap: 1rem;
  }

  .entry + .entry {
    margin-top: 0.25rem;
  }

  /* connected: 直前の項目と年号の背景色を連結する */
  .entry + .entry.connected {
    margin-top: 0;
  }

  .period {
    flex-shrink: 0;
    width: 140px;
    padding: 0.4rem 0.6rem;
    background-color: #e8f0ff;
    font-size: 0.95rem;
  }

  .detail {
    padding: 0.4rem 0;
    white-space: pre-line;
  }

  @media (max-width: 640px) {
    .entry {
      flex-direction: column;
      gap: 0;
      margin-bottom: 0.75rem;
    }
    /* モバイルでは年号と詳細が縦に並ぶため、背景色の連結は行わない */
    .entry + .entry,
    .entry + .entry.connected {
      margin-top: 0;
    }
    .period {
      width: auto;
    }
  }
</style>
